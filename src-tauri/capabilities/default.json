{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "shell:default",
    "shell:allow-open",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://*" },
        { "url": "http://*/*" },
        { "url": "http://*:*" },
        { "url": "http://*:*/*" },
        { "url": "http://*.*" },
        { "url": "http://*.*/*" },
        { "url": "http://*.*:*" },
        { "url": "http://*.*:*/*" },
        { "url": "http://*.*.*" },
        { "url": "http://*.*.*/*" },
        { "url": "http://*.*.*:*" },
        { "url": "http://*.*.*:*/*" },
        { "url": "http://*.*.*.*" },
        { "url": "http://*.*.*.*/*" },
        { "url": "http://*.*.*.*:*" },
        { "url": "http://*.*.*.*:*/*" },
        { "url": "https://*" },
        { "url": "https://*/*" },
        { "url": "https://*:*" },
        { "url": "https://*:*/*" },
        { "url": "https://*.*" },
        { "url": "https://*.*/*" },
        { "url": "https://*.*:*" },
        { "url": "https://*.*:*/*" },
        { "url": "https://*.*.*" },
        { "url": "https://*.*.*/*" },
        { "url": "https://*.*.*:*" },
        { "url": "https://*.*.*:*/*" },
        { "url": "https://*.*.*.*" },
        { "url": "https://*.*.*.*/*" },
        { "url": "https://*.*.*.*:*" },
        { "url": "https://*.*.*.*:*/*" }
      ]
    }
  ]
}
