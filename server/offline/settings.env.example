# TEngineHttpV2 首次安装配置模板：仅用于创建新实例的 settings.env。
# 已有实例的真实配置位于 install.env 指定目录下，更新时不会被此模板覆盖。

# 服务端口：只配置这一处，宿主机映射、容器监听和健康检查使用同一端口。
# 可改为 1–65535 的空闲端口；反向代理的目的地端口也填写同一值。
PORT=8083

# 监听地址：127.0.0.1 = 仅群晖本机访问，推荐配合群晖 HTTPS 反向代理。
# 0.0.0.0 = 所有网卡可访问；如改为此项，请自行限定防火墙访问范围。
BIND_ADDRESS=127.0.0.1

# 浏览器是否只通过 HTTPS 发送登录 Cookie。
# 群晖 HTTPS 反向代理：保持 true，即使代理到容器这一段使用 HTTP。
# 仅临时内网 HTTP 测试时设 false；正式外网访问使用 HTTPS 并保持 true。
COOKIE_SECURE=true

# 初始管理员用户名：3–40 位英文字母、数字、下划线、短横线或点。
# 只在全新数据库首次启动时生效；更改此项不会修改已存在的账号。
BOOTSTRAP_ADMIN_USERNAME=children

# 初始管理员密码：推荐留空，deploy.sh 将在每台机器首次运行时生成独立随机密码。
# 生成后写入实例目录的 settings.env；本模板不保存实际密码。首次登录需要改密。
# 若自行填写，建议 16 位以上字母和数字，服务端最低要求 10 个字符。
# 含特殊符号时用单引号包裹整段值，例如 'YourLongPassword!$123'，避免变量展开。
# 此值只用于空数据库初始化；更新部署不会重置已存在用户的密码。
BOOTSTRAP_ADMIN_PASSWORD=

# 登录会话有效期，单位小时，允许 1–168，默认 24。
TOKEN_EXPIRE_HOURS=24

# 数据目录为独立实例目录内的 data/，与安装包目录无关。
# 不需要在此设置 DATA_DIR、TLS_CERT 或 TLS_KEY。
