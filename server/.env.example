# Only used when initializing an empty management database.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-unique-password
# After initialization, require an existing database instead of creating a new one.
# The offline installer sets this to true for its running instance automatically.
# REQUIRE_EXISTING_DB=true
# Production browser sessions require HTTPS (direct TLS or reverse proxy).
COOKIE_SECURE=true
# For an isolated local HTTP test only: COOKIE_SECURE=false
# PORT=8083
# DATA_DIR=/data
# TOKEN_EXPIRE_HOURS=24
# TLS_CERT=/certs/cert.pem
# TLS_KEY=/certs/key.pem
# HTTPS_PORT=8182
